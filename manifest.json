{
  "manifest_version": 3,
  "name": "AuthTab",
  "version": "1.1.0",
  "description": "Your Google Authenticator 2FA codes in a Firefox toolbar popup. Encrypted with your master password, with optional sync through your own Google Drive.",
  "author": "encryxed",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "AuthTab — 2FA codes",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Open AuthTab"
    }
  },
  "permissions": ["storage", "clipboardWrite", "identity"],
  "optional_host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "authtab@encryxed",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"], "optional": ["authenticationInfo"] }
    }
  }
}
